{
  "name": "@archipen/mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an AI client read and edit the diagram open in the Archipen editor.",
  "type": "module",
  "bin": {
    "archipen-mcp": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p .",
    "test": "npm run build && vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@archipen/render": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-json-patch": "^3.1.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "author": "Archipen contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archipen-dev/archipen.git",
    "directory": "mcp"
  },
  "homepage": "https://archipen.dev/mcp",
  "bugs": {
    "url": "https://github.com/archipen-dev/archipen/issues"
  },
  "keywords": [
    "archipen",
    "mcp",
    "model-context-protocol",
    "diagram",
    "isometric",
    "architecture",
    "ai"
  ]
}
