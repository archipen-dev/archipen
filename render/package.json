{
  "name": "@archipen/render",
  "version": "0.1.0",
  "description": "Render Archipen diagrams to SVG, PNG and PDF without a browser: command line, Node API and HTTP server.",
  "type": "module",
  "bin": {
    "archipen": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "dist",
    "fonts",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "vendor-icon-credits.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "fonts": "node scripts/copy-fonts.mjs",
    "build": "npm run fonts && vite build",
    "typecheck": "tsc -p .",
    "test": "npm run build && vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "jsdom": "^30.1.3",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "author": "Archipen contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archipen-dev/archipen.git",
    "directory": "render"
  },
  "homepage": "https://archipen.dev/export",
  "bugs": {
    "url": "https://github.com/archipen-dev/archipen/issues"
  },
  "keywords": [
    "archipen",
    "diagram",
    "isometric",
    "architecture",
    "svg",
    "png",
    "pdf",
    "cli"
  ]
}
